# Copy to aws/config.env and edit. Do not commit config.env if it contains secrets.
# AWS CLI profile configured locally with `aws configure` or SSO.
export AWS_PROFILE=pulse-deploy
export AWS_REGION=us-east-1
export PULSE_STACK_NAME=pulse-ecg
export PULSE_DESIRED_COUNT=1

# Set true to launch the dedicated Ollama EC2 host. t3.xlarge is CPU-only;
# use a GPU-capable design later if generation latency is unacceptable.
export PULSE_ENABLE_OLLAMA=true
export PULSE_OLLAMA_INSTANCE_TYPE=t3.xlarge
export PULSE_OLLAMA_MODEL=llama3.1:8b
export PULSE_OLLAMA_URL=http://127.0.0.1:11434
# Optional budget fallback: faster local Spark Ollama, tried if the AWS VM is down.
# export PULSE_OLLAMA_FALLBACK_URL=http://<spark-host>:11434
export PULSE_OLLAMA_FALLBACK_URL=

# ACM certificate in the same region, covering pulse.superraev.com.
# Leave empty for HTTP-only ALB access.
export PULSE_CERTIFICATE_ARN=arn:aws:acm:us-east-1:917791789526:certificate/6d2743de-cf6b-4ebb-84bf-9ac4226664c2
export PULSE_DOMAIN_NAME=pulse.superraev.com
